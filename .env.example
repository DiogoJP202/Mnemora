# Backend: configure these as process environment variables or .NET user secrets.
ConnectionStrings__Default=Data Source=mnemora.db
Mnemora__WebOrigin=http://localhost:3000
# Add each trusted reverse-proxy IP in production (index 0, 1, ...).
Mnemora__KnownProxies__0=
# Persist cookie and antiforgery encryption keys across production restarts.
Mnemora__DataProtectionKeysPath=
ASPNETCORE_URLS=http://localhost:5100
ADMIN_EMAIL=
ADMIN_PASSWORD=
GOOGLE_BOOKS_API_KEY=
# Contact e-mail or URL included in the Open Library User-Agent.
OPEN_LIBRARY_CONTACT=

# Assisted editorial generation: backend only; keep disabled without a Groq Free key.
# Verify Free billing and configure Zero Data Retention in the Groq organization.
# Never prefix this key with NEXT_PUBLIC_ or enable a paid fallback.
MemoryPackGeneration__Enabled=false
MemoryPackGeneration__Provider=Groq
MemoryPackGeneration__Model=openai/gpt-oss-120b
MemoryPackGeneration__ApiKey=
MemoryPackGeneration__MaxUnits=64
MemoryPackGeneration__MaxSourceBytes=524288
MemoryPackGeneration__MaxDocumentBytes=2097152
MemoryPackGeneration__MaxReportBytes=2097152
MemoryPackGeneration__MaxSessionBytes=8388608
MemoryPackGeneration__MaxGlobalBytes=16777216
MemoryPackGeneration__MaxSessions=2
MemoryPackGeneration__TimeoutSeconds=90
MemoryPackGeneration__IdleMinutes=30
MemoryPackGeneration__LifetimeMinutes=120
MemoryPackGeneration__MaxAttemptsPerUnit=2
MemoryPackGeneration__MaxCalls=80
MemoryPackGeneration__MaxInputTokens=4000
MemoryPackGeneration__MaxOutputTokens=2500
MemoryPackGeneration__MaxTokens=180000
MemoryPackGeneration__MinCallIntervalSeconds=60

# Frontend: copy these variables to apps/web/.env.local if needed.
API_BASE_URL=http://localhost:5100
MNEMORA_DEMO=false
